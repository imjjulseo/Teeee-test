[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/puzzle_result_panel.gd" id="1_panel"]

[node name="PuzzleResultPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_panel")

[node name="Dim" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"DimPanel"

[node name="Card" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -450.0
offset_top = -390.0
offset_right = 450.0
offset_bottom = 390.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"CardPanel"

[node name="VBox" type="VBoxContainer" parent="Card"]
layout_mode = 2
theme_override_constants/separation = 27
alignment = 1

[node name="ResultStars" type="Label" parent="Card/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 108
text = "★★★"
horizontal_alignment = 1

[node name="ResultHead" type="Label" parent="Card/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 54
text = "최소 수로 성공!"
horizontal_alignment = 1
autowrap_mode = 3

[node name="ResultDetail" type="Label" parent="Card/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 36
horizontal_alignment = 1
autowrap_mode = 3

[node name="ReplayButton" type="Button" parent="Card/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 126)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 42
text = "정답 보기"

[node name="RetryButton" type="Button" parent="Card/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 126)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 42
text = "다시 해 보기"

[node name="NextButton" type="Button" parent="Card/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 126)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 45
text = "다음"

[node name="TapHint" type="Label" parent="Card/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 36
text = "화면을 눌러 계속"
horizontal_alignment = 1

[connection signal="gui_input" from="Dim" to="." method="_on_tap_area_input"]
[connection signal="gui_input" from="Card" to="." method="_on_tap_area_input"]
[connection signal="pressed" from="Card/VBox/ReplayButton" to="." method="_on_replay_button_pressed"]
[connection signal="pressed" from="Card/VBox/RetryButton" to="." method="_on_retry_button_pressed"]
[connection signal="pressed" from="Card/VBox/NextButton" to="." method="_on_next_button_pressed"]
