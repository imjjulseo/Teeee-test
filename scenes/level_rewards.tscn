progression = ExtResource("2_progression")
row_scene = ExtResource("3_row")
spotlight = NodePath("SpotlightOverlay")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
