[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/level_rewards_screen.gd" id="1_screen"]
[ext_resource type="Resource" path="res://resources/progression.tres" id="2_progression"]
[ext_resource type="PackedScene" path="res://scenes/level_reward_row.tscn" id="3_row"]
[ext_resource type="Script" path="res://scripts/scene_navigator.gd" id="4_nav"]
[ext_resource type="Script" path="res://scripts/safe_area.gd" id="90_safe"]
[ext_resource type="PackedScene" path="res://scenes/spotlight_overlay.tscn" id="5_spotlight"]
[ext_resource type="Script" path="res://scripts/theme/token_rect.gd" id="95_token_rect"]

[node name="LevelRewards" type="Control" node_paths=PackedStringArray("spotlight")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_screen")
progression = ExtResource("2_progression")
row_scene = ExtResource("3_row")
spotlight = NodePath("SpotlightOverlay")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"background"

[node name="SafeArea" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("90_safe")

[node name="Content" type="Control" parent="SafeArea"]
layout_mode = 2
mouse_filter = 2

[node name="Layout" type="VBoxContainer" parent="SafeArea/Content"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 60.0
offset_top = 90.0
offset_right = -60.0
offset_bottom = -90.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 30

[node name="Title" type="Label" parent="SafeArea/Content/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 90
text = "레벨 보상"
horizontal_alignment = 1

[node name="SummaryLabel" type="Label" parent="SafeArea/Content/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 42
text = "Lv 1"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="SafeArea/Content/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="SafeArea/Content/Layout/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 18

[node name="BackButton" type="Button" parent="SafeArea/Content/Layout"]
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 60
text = "뒤로"

[node name="SpotlightOverlay" parent="." instance=ExtResource("5_spotlight")]

[node name="MenuNavigator" type="Node" parent="."]
script = ExtResource("4_nav")
target_scene = "res://scenes/main_menu.tscn"

[connection signal="pressed" from="SafeArea/Content/Layout/BackButton" to="MenuNavigator" method="go"]
[connection signal="tapped" from="SpotlightOverlay" to="." method="_on_spotlight_tapped"]
