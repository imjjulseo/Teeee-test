[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/debug_panel.gd" id="1_debug"]
[ext_resource type="Resource" path="res://resources/character_roster.tres" id="2_roster"]

[node name="DebugPanel" type="VBoxContainer"]
theme_override_constants/separation = 10
script = ExtResource("1_debug")
roster = ExtResource("2_roster")

[node name="DebugHeading" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "디버그 (개발 빌드)"

[node name="DebugStatusLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 24
text = "Lv 1 · ● 0 · ◆ 0 · 해금 1"

[node name="DebugRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="GrantButton" type="Button" parent="DebugRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 24
text = "● +1000 ◆ +100"

[node name="LevelButton" type="Button" parent="DebugRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 24
text = "레벨 +1"

[node name="UnlockAllButton" type="Button" parent="DebugRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 24
text = "전부 해금"

[node name="TutorialRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TutorialRestartButton" type="Button" parent="TutorialRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 20
text = "튜토리얼
처음부터"

[node name="TutorialFinishButton" type="Button" parent="TutorialRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 20
text = "튜토리얼
끝냄"

[node name="TutorialGachaButton" type="Button" parent="TutorialRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 20
text = "첫 뽑기
직전"

[node name="TutorialCharacterButton" type="Button" parent="TutorialRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 20
text = "첫 캐릭터
받음"

[connection signal="pressed" from="TutorialRow/TutorialRestartButton" to="." method="_on_tutorial_restart_pressed"]
[connection signal="pressed" from="TutorialRow/TutorialFinishButton" to="." method="_on_tutorial_finish_pressed"]
[connection signal="pressed" from="TutorialRow/TutorialGachaButton" to="." method="_on_tutorial_gacha_pressed"]
[connection signal="pressed" from="TutorialRow/TutorialCharacterButton" to="." method="_on_tutorial_character_pressed"]
[connection signal="pressed" from="DebugRow/GrantButton" to="." method="_on_grant_button_pressed"]
[connection signal="pressed" from="DebugRow/LevelButton" to="." method="_on_level_button_pressed"]
[connection signal="pressed" from="DebugRow/UnlockAllButton" to="." method="_on_unlock_all_button_pressed"]
