[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/character_info.gd" id="1_info"]
[ext_resource type="Resource" path="res://resources/board_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/recipe_view.tscn" id="3_recipe"]
[ext_resource type="PackedScene" path="res://scenes/character_block.tscn" id="4_block"]

[node name="CharacterInfo" type="PanelContainer"]
theme_type_variation = &"SheetPanel"
script = ExtResource("1_info")
theme_data = ExtResource("2_theme")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 21

[node name="InfoBlock" parent="VBox" instance=ExtResource("4_block")]
unique_name_in_owner = true
custom_minimum_size = Vector2(210, 210)
layout_mode = 2
size_flags_horizontal = 4

[node name="SheetNameLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 66
text = "Name"
horizontal_alignment = 1

[node name="SheetGradeLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 39
text = "희귀"
horizontal_alignment = 1

[node name="CharacterBestLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 45
text = "최고점 0"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Details" type="VBoxContainer" parent="VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 21

[node name="EffectBox" type="VBoxContainer" parent="VBox/Scroll/Details"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="AbilityRow" type="HBoxContainer" parent="VBox/Scroll/Details/EffectBox"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24
alignment = 1

[node name="AbilityName" type="Label" parent="VBox/Scroll/Details/EffectBox/AbilityRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"InfoLabel"
theme_override_font_sizes/font_size = 48
text = "능력"

[node name="AbilityKind" type="Label" parent="VBox/Scroll/Details/EffectBox/AbilityRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 39
text = "족보형"

[node name="SheetCondition" parent="VBox/Scroll/Details/EffectBox/AbilityRow" instance=ExtResource("3_recipe")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
hide_points = true

[node name="EffectLabel" type="Label" parent="VBox/Scroll/Details/EffectBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 39
horizontal_alignment = 1
autowrap_mode = 3

[node name="HiddenNote" type="Label" parent="VBox/Scroll/Details"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 39
text = "히든 업적을 달성하면 얻을 수 있어요. 조건은 숨겨져 있어요."
horizontal_alignment = 1
autowrap_mode = 3

[node name="EquipButton" type="Button" parent="VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 54
text = "장착하기"

[node name="PurchaseButton" type="Button" parent="VBox"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"HotButton"
theme_override_font_sizes/font_size = 54
text = "◆ 80"

[node name="LessonButton" type="Button" parent="VBox"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 45
text = "튜토리얼 및 체험"

[connection signal="pressed" from="VBox/EquipButton" to="." method="_on_equip_button_pressed"]
[connection signal="pressed" from="VBox/PurchaseButton" to="." method="_on_purchase_button_pressed"]
[connection signal="pressed" from="VBox/LessonButton" to="." method="_on_lesson_button_pressed"]
