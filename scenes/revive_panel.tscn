[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/revive_panel.gd" id="1_revive"]
[ext_resource type="Script" path="res://scripts/theme/token_rect.gd" id="95_token_rect"]

[node name="RevivePanel" type="CanvasLayer"]
layer = 10
script = ExtResource("1_revive")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("95_token_rect")
token = &"overlay_glass"

[node name="Center" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -330.0
offset_top = -360.0
offset_right = 330.0
offset_bottom = 360.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 30
alignment = 1

[node name="Title" type="Label" parent="Center"]
layout_mode = 2
theme_override_font_sizes/font_size = 84
text = "시간 종료"
horizontal_alignment = 1

[node name="ReviveScoreLabel" type="Label" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 144
text = "0"
horizontal_alignment = 1

[node name="ReviveButton" type="Button" parent="Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 60
text = "◆ 20  부활 +10초"

[node name="EndButton" type="Button" parent="Center"]
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 60
text = "끝내기"

[node name="ReviveWalletLabel" type="Label" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"InfoLabel"
theme_override_font_sizes/font_size = 45
text = "보유 ◆ 0"
horizontal_alignment = 1

[connection signal="pressed" from="Center/ReviveButton" to="." method="_on_revive_button_pressed"]
[connection signal="pressed" from="Center/EndButton" to="." method="_on_end_button_pressed"]
