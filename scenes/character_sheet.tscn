[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/character_sheet.gd" id="1_sheet"]
[ext_resource type="PackedScene" path="res://scenes/character_info.tscn" id="2_info"]

[node name="CharacterSheet" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_sheet")

[node name="Dim" type="Button" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
focus_mode = 0
theme_type_variation = &"DimButton"

[node name="Info" parent="." instance=ExtResource("2_info")]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_left = 0.04
anchor_top = 0.08
anchor_right = 0.96
anchor_bottom = 0.92
grow_horizontal = 2
grow_vertical = 2

[node name="CloseButton" type="Button" parent="."]
layout_mode = 1
anchors_preset = 1
anchor_left = 0.96
anchor_top = 0.08
anchor_right = 0.96
anchor_bottom = 0.08
offset_left = -192.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = 120.0
grow_horizontal = 0
focus_mode = 0
theme_override_font_sizes/font_size = 42
text = "닫기"

[connection signal="pressed" from="Dim" to="." method="_on_close_pressed"]
[connection signal="pressed" from="CloseButton" to="." method="_on_close_pressed"]
[connection signal="purchase_requested" from="Info" to="." method="_on_info_purchase_requested"]
[connection signal="lesson_requested" from="Info" to="." method="_on_info_lesson_requested"]
