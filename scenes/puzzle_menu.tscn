[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/puzzle_menu_screen.gd" id="1_screen"]
[ext_resource type="Resource" path="res://resources/puzzles.tres" id="2_book"]
[ext_resource type="PackedScene" path="res://scenes/puzzle_board_button.tscn" id="3_button"]
[ext_resource type="Script" path="res://scripts/scene_navigator.gd" id="5_nav"]
[ext_resource type="PackedScene" path="res://scenes/spotlight_overlay.tscn" id="80_spot"]
[ext_resource type="Resource" path="res://resources/first_view_tips.tres" id="81_tips"]
[ext_resource type="Script" path="res://scripts/safe_area.gd" id="90_safe"]
[ext_resource type="Script" path="res://scripts/theme/token_rect.gd" id="95_token_rect"]
[ext_resource type="PackedScene" path="res://scenes/wallet_view.tscn" id="97_wallet"]

[node name="PuzzleMenu" type="Control" node_paths=PackedStringArray("spotlight")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_screen")
book = ExtResource("2_book")
board_button_scene = ExtResource("3_button")
tips = ExtResource("81_tips")
spotlight = NodePath("Spotlight")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"background"

[node name="SafeArea" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("90_safe")

[node name="Content" type="Control" parent="SafeArea"]
layout_mode = 2
mouse_filter = 2

[node name="Layout" type="VBoxContainer" parent="SafeArea/Content"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 72.0
offset_right = -48.0
offset_bottom = -72.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 30

[node name="Header" type="HBoxContainer" parent="SafeArea/Content/Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="SafeArea/Content/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 84
text = "퍼즐"

[node name="WalletLabel" parent="SafeArea/Content/Layout/Header" instance=ExtResource("97_wallet")]
unique_name_in_owner = true
layout_mode = 2
font_size = 48

[node name="Note" type="Label" parent="SafeArea/Content/Layout"]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 36
text = "T 모양을 만들어 매치해요 · 처음 깨면 코인"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="SafeArea/Content/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Boards" type="GridContainer" parent="SafeArea/Content/Layout/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 21
theme_override_constants/v_separation = 21
columns = 3

[node name="BackButton" type="Button" parent="SafeArea/Content/Layout"]
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 60
text = "뒤로"

[node name="MenuNavigator" type="Node" parent="."]
script = ExtResource("5_nav")
target_scene = "res://scenes/main_menu.tscn"

[node name="PlayNavigator" type="Node" parent="."]
script = ExtResource("5_nav")
target_scene = "res://scenes/puzzle_play.tscn"

[node name="Spotlight" parent="." instance=ExtResource("80_spot")]

[connection signal="pressed" from="SafeArea/Content/Layout/BackButton" to="MenuNavigator" method="go"]
[connection signal="play_requested" from="." to="PlayNavigator" method="go"]
[connection signal="tapped" from="Spotlight" to="." method="_on_spotlight_tapped"]
