[ext_resource type="PackedScene" path="res://scenes/star_row.tscn" id="3_stars"]
[ext_resource type="Script" path="res://scripts/ui_image.gd" id="4_image"]
[ext_resource type="Resource" path="res://resources/ui_assets.tres" id="5_assets"]
[ext_resource type="Script" path="res://scripts/theme/token_rect.gd" id="95_token_rect"]

[node name="PuzzleBoardButton" type="Button"]
mouse_filter = 1
custom_minimum_size = Vector2(555, 780)
focus_mode = 0
theme_type_variation = &"PuzzleCardButton"
script = ExtResource("1_button")

[node name="Link" type="ColorRect" parent="."]
unique_name_in_owner = true
show_behind_parent = true
layout_mode = 1
anchors_preset = 6
anchor_left = 1.0
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_top = -6.0
offset_right = 48.0
offset_bottom = 6.0
grow_vertical = 2
mouse_filter = 2
