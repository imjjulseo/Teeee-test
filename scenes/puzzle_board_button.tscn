[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/puzzle_board_button.gd" id="1_button"]
[ext_resource type="Script" path="res://scripts/puzzle_mini_view.gd" id="2_mini"]

[node name="PuzzleBoardButton" type="Button"]
custom_minimum_size = Vector2(225, 315)
focus_mode = 0
script = ExtResource("1_button")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 22.5
offset_top = 18.0
offset_right = -22.5
offset_bottom = -15.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 9

[node name="Number" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 36
text = "1"
horizontal_alignment = 1

[node name="Mini" type="Control" parent="VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 180)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
script = ExtResource("2_mini")

[node name="Stars" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 36
text = "● 20"
horizontal_alignment = 1

[connection signal="pressed" from="." to="." method="_on_pressed"]
