[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/level_reward_row.gd" id="1_row"]
[ext_resource type="Script" path="res://scripts/theme/token_rect.gd" id="95_token_rect"]

[node name="LevelRewardRow" type="HBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 24
script = ExtResource("1_row")

[node name="LevelLabel" type="Label" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
size_flags_vertical = 0
theme_override_font_sizes/font_size = 42
text = "Lv.1"
horizontal_alignment = 2

[node name="Tower" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="NodeButton" type="Button" parent="Tower"]
unique_name_in_owner = true
custom_minimum_size = Vector2(480, 126)
layout_mode = 2
size_flags_horizontal = 4
focus_mode = 0
mouse_filter = 1
theme_type_variation = &"LevelNodeButton"

[node name="NodeBox" type="VBoxContainer" parent="Tower/NodeButton"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 18.0
offset_top = 12.0
offset_right = -18.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 3
alignment = 1

[node name="RewardsLabel" type="Label" parent="Tower/NodeButton/NodeBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 33
text = "—"
horizontal_alignment = 1
autowrap_mode = 3

[node name="StateLabel" type="Label" parent="Tower/NodeButton/NodeBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"InfoLabel"
theme_override_font_sizes/font_size = 30
horizontal_alignment = 1

[node name="ClaimLabel" type="Label" parent="Tower/NodeButton/NodeBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"WarmAccentLabel"
theme_override_font_sizes/font_size = 36
text = "받기"
horizontal_alignment = 1

[node name="Stem" type="ColorRect" parent="Tower"]
unique_name_in_owner = true
custom_minimum_size = Vector2(30, 120)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"track"

[node name="StemFill" type="ColorRect" parent="Tower/Stem"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"info"

[connection signal="pressed" from="Tower/NodeButton" to="." method="_on_node_button_pressed"]
