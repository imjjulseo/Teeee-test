[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/character_chain_group.gd" id="1_group"]
[ext_resource type="PackedScene" path="res://scenes/achievement_row.tscn" id="2_row"]

[node name="CharacterChainGroup" type="VBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 15
script = ExtResource("1_group")
row_scene = ExtResource("2_row")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 18

[node name="ChainName" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 45
text = "이름"

[node name="ChainGrade" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 36
text = "희귀"

[node name="ChainOwned" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 36
text = "미보유"

[node name="ChainRows" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12
