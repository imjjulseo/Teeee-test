[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/pause_overlay.gd" id="1_pause"]
[ext_resource type="Script" path="res://scripts/theme/token_rect.gd" id="95_token_rect"]

[node name="PauseOverlay" type="CanvasLayer"]
layer = 10
script = ExtResource("1_pause")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("95_token_rect")
token = &"overlay"

[node name="Center" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -220.0
offset_right = 200.0
offset_bottom = 220.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 32
alignment = 1

[node name="Title" type="Label" parent="Center"]
layout_mode = 2
theme_override_font_sizes/font_size = 72
text = "일시정지"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Center"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 40
text = "계속"

[node name="RestartButton" type="Button" parent="Center"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 40
text = "다시 시작"

[node name="MainMenuButton" type="Button" parent="Center"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 40
text = "메뉴"

[node name="MainMenuNote" type="Label" parent="Center"]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 22
text = "다시 시작하거나 메뉴로 나가면 이번 판 점수는 기록되지 않습니다"
horizontal_alignment = 1
autowrap_mode = 3

[connection signal="pressed" from="Center/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Center/RestartButton" to="." method="_on_restart_button_pressed"]
[connection signal="pressed" from="Center/MainMenuButton" to="." method="_on_main_menu_button_pressed"]
