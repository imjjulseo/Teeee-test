[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/pause_overlay.gd" id="1_pause"]
[ext_resource type="Script" path="res://scripts/theme/token_rect.gd" id="95_token_rect"]
[ext_resource type="PackedScene" path="res://scenes/quick_options.tscn" id="2_quick"]

[node name="PauseOverlay" type="CanvasLayer"]
layer = 10
script = ExtResource("1_pause")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("95_token_rect")
token = &"overlay"

[node name="Center" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -430.0
offset_right = 300.0
offset_bottom = 430.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 48
alignment = 1

[node name="Title" type="Label" parent="Center"]
layout_mode = 2
theme_override_font_sizes/font_size = 108
text = "일시정지"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Center"]
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 60
text = "계속"

[node name="RestartButton" type="Button" parent="Center"]
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 60
text = "다시 시작"

[node name="OptionsButton" type="Button" parent="Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 60
text = "설정"

[node name="MainMenuButton" type="Button" parent="Center"]
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 60
text = "메뉴"

[node name="MainMenuNote" type="Label" parent="Center"]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 33
text = "다시 시작하거나 메뉴로 나가면 이번 판 점수는 남지 않아요"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Options" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -390.0
offset_top = -560.0
offset_right = 390.0
offset_bottom = 560.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 48
alignment = 1

[node name="OptionsTitle" type="Label" parent="Options"]
layout_mode = 2
theme_override_font_sizes/font_size = 90
text = "설정"
horizontal_alignment = 1

[node name="QuickOptions" parent="Options" instance=ExtResource("2_quick")]
unique_name_in_owner = true
layout_mode = 2
show_notes = false

[node name="BackButton" type="Button" parent="Options"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 60
text = "돌아가기"

[connection signal="pressed" from="Center/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Center/RestartButton" to="." method="_on_restart_button_pressed"]
[connection signal="pressed" from="Center/MainMenuButton" to="." method="_on_main_menu_button_pressed"]
[connection signal="pressed" from="Center/OptionsButton" to="." method="_on_options_button_pressed"]
[connection signal="pressed" from="Options/BackButton" to="." method="_on_back_button_pressed"]
[connection signal="control_mode_changed" from="Options/QuickOptions" to="." method="_on_control_mode_changed"]
[connection signal="reduce_motion_changed" from="Options/QuickOptions" to="." method="_on_reduce_motion_changed"]
