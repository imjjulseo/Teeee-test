[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/spotlight_overlay.gd" id="1_spot"]
[ext_resource type="Shader" path="res://resources/shaders/spotlight.gdshader" id="2_shader"]
[ext_resource type="Script" path="res://scripts/caption_icon.gd" id="3_icon"]
[ext_resource type="Resource" path="res://resources/board_theme.tres" id="4_theme"]
[ext_resource type="Script" path="res://scripts/segment_bar.gd" id="5_segments"]
[ext_resource type="Script" path="res://scripts/tap_ring.gd" id="6_tap"]
[ext_resource type="PackedScene" path="res://scenes/tutorial_puzzle_bar.tscn" id="7_bar"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_dim"]
shader = ExtResource("2_shader")

[node name="SpotlightOverlay" type="CanvasLayer"]
layer = 5
script = ExtResource("1_spot")

[node name="Blocker" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="."]
unique_name_in_owner = true
material = SubResource("ShaderMaterial_dim")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Caption" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 28.0
offset_top = -40.0
offset_right = -28.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 0
theme_type_variation = &"CaptionPanel"

[node name="HBox" type="HBoxContainer" parent="Caption"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 22

[node name="Icon" type="Control" parent="Caption/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(92, 92)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("3_icon")
theme_data = ExtResource("4_theme")

[node name="Body" type="VBoxContainer" parent="Caption/HBox"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 6
alignment = 1

[node name="Segments" type="Control" parent="Caption/HBox/Body"]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 2
script = ExtResource("5_segments")

[node name="CaptionHead" type="Label" parent="Caption/HBox/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "제목"
autowrap_mode = 3

[node name="CaptionText" type="Label" parent="Caption/HBox/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "설명"
autowrap_mode = 3

[node name="Foot" parent="Caption/HBox/Body" instance=ExtResource("7_bar")]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="TapHint" type="Control" parent="Caption/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(54, 54)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("6_tap")

[node name="AltButton" type="Button" parent="Caption/HBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_override_font_sizes/font_size = 28
text = "바로 시작"
flat = true

[node name="CaptionButton" type="Button" parent="Caption/HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"AccentButton"
theme_override_font_sizes/font_size = 28
text = "계속"

[node name="SkipButton" type="Button" parent="."]
unique_name_in_owner = true
offset_right = 120.0
offset_bottom = 44.0
focus_mode = 0
theme_type_variation = &"PillButton"
theme_override_font_sizes/font_size = 22
text = "건너뛰기"

[connection signal="gui_input" from="Blocker" to="." method="_on_blocker_gui_input"]
[connection signal="gui_input" from="Caption" to="." method="_on_blocker_gui_input"]
[connection signal="resized" from="Caption" to="." method="_on_caption_resized"]
[connection signal="resized" from="Dim" to="." method="_on_dim_resized"]
[connection signal="pressed" from="SkipButton" to="." method="_on_skip_button_pressed"]
[connection signal="pressed" from="Caption/HBox/CaptionButton" to="." method="_on_caption_button_pressed"]
[connection signal="pressed" from="Caption/HBox/AltButton" to="." method="_on_alt_button_pressed"]
