[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/character_card.gd" id="1_card"]
[ext_resource type="Resource" path="res://resources/board_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/recipe_view.tscn" id="3_recipe"]
[ext_resource type="Script" path="res://scripts/portrait_rect.gd" id="96_portrait"]

[node name="CharacterCard" type="Button"]
custom_minimum_size = Vector2(375, 600)
focus_mode = 0
toggle_mode = true
script = ExtResource("1_card")
theme_data = ExtResource("2_theme")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 30

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 18
alignment = 1

[node name="Preview" type="Panel" parent="Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(144, 144)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2

[node name="Portrait" type="TextureRect" parent="Margin/VBox/Preview"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 6.0
offset_top = 6.0
offset_right = -6.0
offset_bottom = -6.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5
script = ExtResource("96_portrait")
[node name="NameLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "Name"
horizontal_alignment = 1
autowrap_mode = 3

[node name="GradeLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 33
text = "희귀"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 36
text = "잠김"
horizontal_alignment = 1

[node name="Condition" parent="Margin/VBox" instance=ExtResource("3_recipe")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
is_ability = true

[node name="PassiveLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 33
text = "항상 켜짐"
horizontal_alignment = 1

[connection signal="pressed" from="." to="." method="_on_pressed"]
