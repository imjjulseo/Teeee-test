[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/quick_options.gd" id="1_quick"]

[node name="QuickOptions" type="VBoxContainer"]
theme_override_constants/separation = 30
script = ExtResource("1_quick")

[node name="ControlHeading" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 45
text = "조작"

[node name="ControlRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24

[node name="SwipeButton" type="Button" parent="ControlRow"]
mouse_filter = 1
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 45
theme_type_variation = &"ChoiceButton"
toggle_mode = true
text = "스와이프"

[node name="DpadButton" type="Button" parent="ControlRow"]
mouse_filter = 1
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 45
theme_type_variation = &"ChoiceButton"
toggle_mode = true
text = "방향키"

[node name="VolumeHeading" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 45
text = "소리"

[node name="MasterRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 36

[node name="MasterVolumeSlider" type="HSlider" parent="MasterRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 132)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"VolumeSlider"
max_value = 100.0
rounded = true
value = 100.0

[node name="MasterVolumeLabel" type="Label" parent="MasterRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(135, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 54
text = "100"
horizontal_alignment = 2

[node name="ReduceMotionToggle" type="CheckButton" parent="."]
mouse_filter = 1
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 144)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 48
text = "효과 줄이기"

[connection signal="pressed" from="ControlRow/SwipeButton" to="." method="_on_swipe_button_pressed"]
[connection signal="pressed" from="ControlRow/DpadButton" to="." method="_on_dpad_button_pressed"]
[connection signal="value_changed" from="MasterRow/MasterVolumeSlider" to="." method="_on_master_volume_changed"]
[connection signal="drag_ended" from="MasterRow/MasterVolumeSlider" to="." method="_on_master_volume_drag_ended"]
[connection signal="toggled" from="ReduceMotionToggle" to="." method="_on_reduce_motion_toggled"]
