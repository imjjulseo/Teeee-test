[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/achievement_row.gd" id="1_row"]
[ext_resource type="Script" path="res://scripts/theme/token_rect.gd" id="95_token_rect"]

[node name="AchievementRow" type="PanelContainer"]
mouse_filter = 2
theme_type_variation = &"AchievementRowPanel"
script = ExtResource("1_row")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 18

[node name="VBox" type="VBoxContainer" parent="HBox"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 9
alignment = 1

[node name="AchName" type="Label" parent="HBox/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 39
text = "업적"

[node name="AchText" type="Label" parent="HBox/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 33
text = "조건"
autowrap_mode = 3

[node name="Bottom" type="HBoxContainer" parent="HBox/VBox"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 18

[node name="AchBar" type="ColorRect" parent="HBox/VBox/Bottom"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 15)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"track"

[node name="AchFill" type="ColorRect" parent="HBox/VBox/Bottom/AchBar"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 9
anchor_bottom = 1.0
grow_vertical = 2
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"info"

[node name="AchValue" type="Label" parent="HBox/VBox/Bottom"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 33
text = "0 / 1"
horizontal_alignment = 2

[node name="RewardBox" type="PanelContainer" parent="HBox"]
custom_minimum_size = Vector2(150, 96)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"RewardPreviewPanel"

[node name="AchReward" type="Label" parent="HBox/RewardBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 33
text = "● 100"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="ClaimButton" type="Button" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(135, 96)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
mouse_filter = 1
theme_type_variation = &"HotButton"
theme_override_font_sizes/font_size = 36
disabled = true
text = "받기"

[connection signal="pressed" from="HBox/ClaimButton" to="." method="_on_claim_button_pressed"]
