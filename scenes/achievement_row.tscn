[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/achievement_row.gd" id="1_row"]
[ext_resource type="Script" path="res://scripts/theme/token_rect.gd" id="95_token_rect"]

[node name="AchievementRow" type="PanelContainer"]
theme_type_variation = &"AchievementRowPanel"
script = ExtResource("1_row")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Top" type="HBoxContainer" parent="VBox"]
layout_mode = 2
mouse_filter = 2

[node name="AchName" type="Label" parent="VBox/Top"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 26
text = "업적"

[node name="AchReward" type="Label" parent="VBox/Top"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 22
text = "● 100"

[node name="AchText" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 22
text = "조건"
autowrap_mode = 3

[node name="Bottom" type="HBoxContainer" parent="VBox"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="AchBar" type="ColorRect" parent="VBox/Bottom"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"track"

[node name="AchFill" type="ColorRect" parent="VBox/Bottom/AchBar"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 9
anchor_bottom = 1.0
grow_vertical = 2
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"info"

[node name="AchValue" type="Label" parent="VBox/Bottom"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "0 / 1"
horizontal_alignment = 2
