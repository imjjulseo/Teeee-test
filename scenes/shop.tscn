[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/shop_screen.gd" id="1_shop"]
[ext_resource type="Resource" path="res://resources/character_roster.tres" id="2_roster"]
[ext_resource type="Resource" path="res://resources/progression.tres" id="3_progression"]
[ext_resource type="Resource" path="res://resources/board_theme.tres" id="4_theme"]
[ext_resource type="PackedScene" path="res://scenes/pool_chip.tscn" id="5_chip"]
[ext_resource type="PackedScene" path="res://scenes/ticket_row.tscn" id="6_ticket"]
[ext_resource type="PackedScene" path="res://scenes/grade_header.tscn" id="7_header"]
[ext_resource type="PackedScene" path="res://scenes/shop_row.tscn" id="8_row"]
[ext_resource type="PackedScene" path="res://scenes/gacha_chest.tscn" id="9_chest"]
[ext_resource type="PackedScene" path="res://scenes/gacha_reveal.tscn" id="10_reveal"]
[ext_resource type="Script" path="res://scripts/scene_navigator.gd" id="11_nav"]
[ext_resource type="Script" path="res://scripts/safe_area.gd" id="90_safe"]
[ext_resource type="Resource" path="res://resources/tutorial.tres" id="12_tutorial"]
[ext_resource type="PackedScene" path="res://scenes/spotlight_overlay.tscn" id="13_spotlight"]
[ext_resource type="Script" path="res://scripts/theme/token_rect.gd" id="95_token_rect"]
[ext_resource type="PackedScene" path="res://scenes/wallet_view.tscn" id="97_wallet"]

[node name="Shop" type="Control" node_paths=PackedStringArray("spotlight")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shop")
roster = ExtResource("2_roster")
progression = ExtResource("3_progression")
theme_data = ExtResource("4_theme")
pool_chip_scene = ExtResource("5_chip")
ticket_row_scene = ExtResource("6_ticket")
grade_header_scene = ExtResource("7_header")
shop_row_scene = ExtResource("8_row")
tutorial = ExtResource("12_tutorial")
spotlight = NodePath("SpotlightOverlay")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"background"

[node name="SafeArea" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("90_safe")

[node name="Content" type="Control" parent="SafeArea"]
layout_mode = 2
mouse_filter = 2

[node name="Layout" type="VBoxContainer" parent="SafeArea/Content"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 32.0
offset_top = 48.0
offset_right = -32.0
offset_bottom = -48.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="Header" type="HBoxContainer" parent="SafeArea/Content/Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="SafeArea/Content/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 56
text = "상점"

[node name="WalletLabel" parent="SafeArea/Content/Layout/Header" instance=ExtResource("97_wallet")]
unique_name_in_owner = true
layout_mode = 2
font_size = 32

[node name="Tabs" type="HBoxContainer" parent="SafeArea/Content/Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="GachaTab" type="Button" parent="SafeArea/Content/Layout/Tabs"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 30
theme_type_variation = &"TabButton"
toggle_mode = true
text = "뽑기"

[node name="ShopTab" type="Button" parent="SafeArea/Content/Layout/Tabs"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 30
theme_type_variation = &"TabButton"
toggle_mode = true
text = "상점"

[node name="GachaPage" type="ScrollContainer" parent="SafeArea/Content/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="SafeArea/Content/Layout/GachaPage"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="Chest" parent="SafeArea/Content/Layout/GachaPage/VBox" instance=ExtResource("9_chest")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4

[node name="TapLabel" type="Label" parent="SafeArea/Content/Layout/GachaPage/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 26
text = "상자를 눌러 열기"
horizontal_alignment = 1

[node name="PullButton" type="Button" parent="SafeArea/Content/Layout/GachaPage/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 36
text = "열기 · ● 350"

[node name="RateLabel" type="Label" parent="SafeArea/Content/Layout/GachaPage/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "신화 0.1% · 전설 0.9% · 영웅 34% · 희귀 65%"
horizontal_alignment = 1
autowrap_mode = 3

[node name="TierLabel" type="Label" parent="SafeArea/Content/Layout/GachaPage/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 22
text = "뽑기 1단계"
horizontal_alignment = 1
autowrap_mode = 3

[node name="TierBar" type="ColorRect" parent="SafeArea/Content/Layout/GachaPage/VBox"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"track"

[node name="TierFill" type="ColorRect" parent="SafeArea/Content/Layout/GachaPage/VBox/TierBar"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 9
anchor_bottom = 1.0
grow_vertical = 2
mouse_filter = 2
script = ExtResource("95_token_rect")
token = &"info"

[node name="PoolTitle" type="Label" parent="SafeArea/Content/Layout/GachaPage/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "나오는 캐릭터"

[node name="Pool" type="HFlowContainer" parent="SafeArea/Content/Layout/GachaPage/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="AdButton" type="Button" parent="SafeArea/Content/Layout/GachaPage/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 26
text = "광고 보고 ◆ 5 · 오늘 0/3"

[node name="ShopPage" type="ScrollContainer" parent="SafeArea/Content/Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="SafeArea/Content/Layout/ShopPage"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="TicketsTitle" type="Label" parent="SafeArea/Content/Layout/ShopPage/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "선택권"

[node name="Tickets" type="VBoxContainer" parent="SafeArea/Content/Layout/ShopPage/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="CharactersTitle" type="Label" parent="SafeArea/Content/Layout/ShopPage/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "다이아 상점"

[node name="Characters" type="VBoxContainer" parent="SafeArea/Content/Layout/ShopPage/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="BackButton" type="Button" parent="SafeArea/Content/Layout"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 40
text = "뒤로"

[node name="Reveal" parent="." instance=ExtResource("10_reveal")]
unique_name_in_owner = true
layout_mode = 1

[node name="SpotlightOverlay" parent="." instance=ExtResource("13_spotlight")]

[node name="MenuNavigator" type="Node" parent="."]
script = ExtResource("11_nav")
target_scene = "res://scenes/main_menu.tscn"

[connection signal="pressed" from="SafeArea/Content/Layout/Tabs/GachaTab" to="." method="_on_gacha_tab_pressed"]
[connection signal="pressed" from="SafeArea/Content/Layout/Tabs/ShopTab" to="." method="_on_shop_tab_pressed"]
[connection signal="pressed" from="SafeArea/Content/Layout/GachaPage/VBox/Chest" to="." method="_on_pull_requested"]
[connection signal="opened" from="SafeArea/Content/Layout/GachaPage/VBox/Chest" to="." method="_on_chest_opened"]
[connection signal="pressed" from="SafeArea/Content/Layout/GachaPage/VBox/PullButton" to="." method="_on_pull_requested"]
[connection signal="pressed" from="SafeArea/Content/Layout/GachaPage/VBox/AdButton" to="." method="_on_ad_button_pressed"]
[connection signal="closed" from="Reveal" to="." method="_on_reveal_closed"]
[connection signal="pressed" from="SafeArea/Content/Layout/BackButton" to="MenuNavigator" method="go"]
[connection signal="tapped" from="SpotlightOverlay" to="." method="_on_spotlight_tapped"]
