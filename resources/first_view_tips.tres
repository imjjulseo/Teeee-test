[gd_resource type="Resource" script_class="FirstViewTips" format=3]

[ext_resource type="Script" path="res://scripts/tutorial/first_view_tips.gd" id="1_tips"]

[resource]
script = ExtResource("1_tips")
multi_head = "족보 동시 진행"
multi_text = "같은 색을 기다리는 족보는 한 번 매치로 함께 채워져요"
experience_head = "경험치"
experience_text = "점수가 높을수록 경험치를 많이 받아요"
achievements_head = "업적"
achievements_text = "조건을 채우면 코인과 다이아를 받아요"
hidden_head = "히든 업적"
hidden_text = "조건은 비밀이에요. 달성하면 히든 캐릭터를 얻어요"
characters_head = "캐릭터"
characters_text = "좌우로 넘기며 능력을 확인하고 장착해요. 없는 캐릭터도 체험해 볼 수 있어요"
puzzles_head = "퍼즐"
puzzles_text = "T 모양을 만드는 퍼즐이에요. 판마다 처음 풀면 코인을 받아요"
