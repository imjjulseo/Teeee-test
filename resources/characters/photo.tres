[resource]
script = ExtResource("1_char")
id = &"photo"
display_name = "사진사"
grade = 4
ability = SubResource("Ability_1")
ability_name = "찰칵"
ability_description = "찰칵: 7초 동안 판이 사진으로 멈추고(시간·리필 정지) 스와이프는 경로만 계획(최대 60수)"
summary = "7초 동안 판이 멈추고 갈 길을 미리 그려요. 끝나면 한 번에 움직여요"
detail_effect = "7초 동안 판이 사진처럼 멈추고, 시간도 씨앗도 멈춰요. 그동안 스와이프하면 실제로 움직이지 않고 갈 길만 그려져요(사진 위 점선, 최대 60수). 사진이 깨지면 그린 길대로 드르륵 움직여요. 갈수록 빨라지다가, 매치하면 쾅! 잠깐 멈칫한 뒤 다시 빨라져요. 이때 매치마다 보너스: 1번 250 / 2번 500 / 3번 1,000 / 4번 2,000 …(매번 2배, 6번까지). 움직이는 동안에도 시간은 멈춰 있어요."
condition_colors = PackedInt32Array(2, 0, 3, 1)
accent_color = Color(0.956863, 0.956863, 0.956863, 1)
player_fill = Color(0.21051, 0.21051, 0.21051, 1)
player_border = Color(0.956863, 0.956863, 0.956863, 1)
