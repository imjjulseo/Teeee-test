[resource]
script = ExtResource("1_char")
id = &"madan"
display_name = "마탄"
grade = 4
ability = SubResource("Ability_1")
ability_name = "장전"
ability_description = "장전: 씨앗 전부 즉시 성장 + 시간 정지 + 6발"
detail_effect = "재생 중인 칸이 모두 즉시 채워지고, 시간이 멈춘 채 6발이 장전돼요. 이동할 때마다 들어가는 칸의 블럭을 쏴서 없애고 그 색으로 족보를 진행해요. 탄으로 완성한 족보는 점수 ×1.25. 장전은 18초까지, 6발을 다 쏘거나 18초가 지나면 7번째 탄의 저주가 터져요(시간 −8초 / 점수 −1,000 / 이번에 쏜 칸 30초간 재생 안 됨)."
detail_when = "족보에 필요한 색이 판 여기저기 흩어져 있을 때"
detail_tip = "6발로 족보 여러 개를 한꺼번에 노리세요. 저주 종류는 탄창 옆에 미리 보여요."
condition_colors = PackedInt32Array(1, 3, 2, 0, 3)
accent_color = Color(0.780392, 0.490196, 1, 1)
player_fill = Color(0.171686, 0.107843, 0.22, 1)
