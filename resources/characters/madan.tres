ability_name = "장전"
ability_description = "장전: 씨앗 전부 즉시 성장 + 시간 정지 + 6발"
detail_effect = "씨앗이 모두 바로 자라고, 시간이 멈춘 채 6발이 장전돼요. 움직일 때마다 들어가는 칸의 블록을 쏴서 없애고 그 색으로 족보를 채워요. 탄으로 완성한 족보는 점수 ×1.25. 장전은 18초 동안이고, 6발을 다 쏘거나 18초가 지나면 7번째 탄의 저주가 터져요(시간 −8초 / 점수 −1,000 / 이번에 쏜 칸이 30초 동안 자라지 않음 중 하나)."
