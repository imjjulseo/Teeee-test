[resource]
script = ExtResource("1_char")
id = &"seer"
display_name = "예지안"
grade = 3
ability = SubResource("Ability_1")
ability_name = "예언"
ability_description = "상시: 씨앗이 자랄 색이 보임. 예언: 같은 색 ㅗ·ㅜ·ㅓ·ㅏ 모양을 모두 매치"
summary = "씨앗이 자랄 색이 보여요.\n발동하면 판에 있는 같은 색 T 모양을 모두 매치해요"
detail_effect = "씨앗이 어떤 색으로 자랄지 미리 보여요.\n캐릭터 족보를 완성하면 판에서 같은 색 4칸이 T 모양(ㅗ, ㅜ, ㅓ, ㅏ)을 이룬 곳을 모두 찾아 매치해요.\n씨앗은 자랄 색으로 치고, 한 블록은 한 모양에만 쓰여요.\n모양마다 매치 시간을 얻고, 모양 수만큼 일반 족보가 모두 차요."
condition_colors = PackedInt32Array(3, 2, 0, 1)
accent_color = Color(0.603922, 0.509804, 1, 1)
player_fill = Color(0.132863, 0.112157, 0.22, 1)
player_border = Color(0.603922, 0.509804, 1, 1)
