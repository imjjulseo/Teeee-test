ability = SubResource("Ability_1")
ability_name = "피버"
ability_description = "피버 10초: 색 무관 매치마다 스택 +1, 리필 ×2"
detail_effect = "10초 피버! 피버 중엔 색과 상관없이 매치할 때마다 스택이 1개씩 쌓이고(판 가운데 큰 숫자), 리필이 2배 빨라요. 족보는 평소처럼 진행돼요. 피버가 끝나면 스택 n개에 대해 50 × n(n+1)/2 점을 한 번에 받아요(5스택 750 · 10스택 2,750 · 15스택 6,000)."
detail_when = "매치를 빠르게 이어 갈 수 있을 때"
detail_tip = "피버 중엔 어떤 색을 깨도 거의 점수예요. 속도가 곧 점수예요."
condition_colors = PackedInt32Array(3, 0, 2)
accent_color = Color(1, 0.478431, 0.270588, 1)
player_fill = Color(0.24, 0.12, 0.08, 1)
