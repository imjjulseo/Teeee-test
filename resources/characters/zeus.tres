ability = SubResource("Ability_1")
ability_name = "낙뢰"
ability_description = "낙뢰: 시간·리필 정지 + 판의 노랑을 모두 흡수(그 자리 씨앗)"
detail_effect = "캐릭터 족보(노랑 4칸)를 완성하면 시간과 씨앗이 멈추고 판의 노랑 블록을 모두 흡수해요(그 자리는 씨앗). 1초 뒤부터 0.5초마다 낙뢰가 떨어져 족보를 색과 상관없이 한 칸씩 채워요. 4칸 족보부터 채우고, 완성되면 3칸 → 2칸 순서로 넘어가요. 흡수한 수만큼 채우면 시간이 다시 흘러요. 그동안은 움직일 수 없어요."
condition_colors = PackedInt32Array(0, 0, 0, 0)
