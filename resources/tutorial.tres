[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_move")

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("3_say")
head = "자리 바꾸기"
text = "움직이면 나(빈칸)와 옆 블럭이 자리를 바꿔요"
holes = PackedStringArray("player")

[sub_resource type="Resource" id="Step_3"]
script = ExtResource("3_say")
head = "매치"
text = "나를 둘러싼 4칸이 모두 같은 색이면 사라지고 시간을 얻어요"
holes = PackedStringArray("player", "time")

[sub_resource type="Resource" id="Step_4"]
script = ExtResource("3_say")
head = "가장 쉬운 방법"
text = "ㅗ 모양을 만든 뒤, 열린 쪽에서 가운데로 들어가요"
holes = null

[sub_resource type="Resource" id="Step_5"]
script = ExtResource("4_level")
hold_seeds_after = true

[sub_resource type="Resource" id="Step_6"]
script = ExtResource("3_say")
head = "다시 자라는 칸"
text = "사라진 블럭은 잠시 뒤 무작위 색으로 다시 자라요"
holes = PackedStringArray("seeds")
grow_seeds = true

[sub_resource type="Resource" id="Step_7"]
script = ExtResource("4_level")
