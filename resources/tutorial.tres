[sub_resource type="Resource" id="Step_11"]
script = ExtResource("3_say")
head = "족보"
text = "점수를 얻으려면 족보를 완성해야 해요"
holes = PackedStringArray("cards")

[sub_resource type="Resource" id="Step_12"]
script = ExtResource("3_say")
head = "순서대로"
text = "족보의 색 순서대로 매치하면 완성돼요. 흰 테두리가 다음 색이에요"
holes = PackedStringArray("cards")

[sub_resource type="Resource" id="Step_13"]
script = ExtResource("3_say")
head = "진행은 그대로"
text = "족보 색이 아닌 블럭을 매치해도 진행도는 초기화되지 않아요"
holes = PackedStringArray("cards")

[sub_resource type="Resource" id="Step_14"]
