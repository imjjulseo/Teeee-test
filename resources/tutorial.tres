head = "5개 매치시켜 보세요"
text = "{done} / {count} · 막히면 잠시 기다려 보세요. 만들 자리를 보여 줘요"
progress_text = "{done} / {count}"
holes = null
cheer_done = "완벽해요!"

[sub_resource type="Resource" id="Step_10"]
script = ExtResource("5_board")
